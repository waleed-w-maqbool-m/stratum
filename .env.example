# Stratum environment. Copy to .env and fill in.

# Fernet key for encrypting stored connection credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STRATUM_SECRET_KEY=

# App store (SQLite) location.
STRATUM_HOME=.stratum

# LLM providers. Any subset; the client falls through them in order.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Benchmark database containers (see infra/docker-compose.yml)
MSSQL_SA_PASSWORD=Stratum!Passw0rd
POSTGRES_PASSWORD=stratum
